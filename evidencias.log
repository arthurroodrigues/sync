        int assentos;
};

void *passageiro(void *arg)
{
        station_wait_for_car((struct station *) arg);
        __sync_add_and_fetch(&embarcados, 1);
        return NULL;
}

void *carro(void *arg)
{
        struct dados *d = (struct dados *) arg;
        station_load_car(d->estacao, d->assentos);
        carro_saiu = 1;
        return NULL;
}

void estourou(int sinal)
